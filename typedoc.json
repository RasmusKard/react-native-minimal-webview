{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "plugin": ["./.github/scripts/typedoc-plugin.mts"],
  "readme": "none",
  "disableSources": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "validation": { "notExported": false },
  "navigation": { "includeGroups": true },
  "visibilityFilters": { "@android": true, "@ios": true },
  "locales": { "en": { "tag_ios": "iOS" } },
  "groupOrder": ["WebView", "Navigation", "Events", "Bridge", "Scripts", "Page requests", "Native hooks", "Platform settings"]
}
