{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs/api",
  "readme": "none",
  "disableSources": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "validation": { "notExported": false },
  "navigation": { "includeGroups": true },
  "groupOrder": ["WebView", "Navigation", "Events", "Bridge", "Scripts", "Page requests", "Native hooks", "Platform settings"]
}
