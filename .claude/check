#!/bin/sh
# The repo's own checks, shared by agent-guard's Stop hook, git pre-commit (lefthook) and CI. POSIX sh.
# Each tool runs only if its config file is in the repo; the same script serves every template.
#   CHECK_DIFF  command printing a git diff to judge. Line-based linters (oxlint, ruff, ...) report only lines it
#               adds. Default: the staged changes. agent-guard passes the session's diff; CI passes the PR's.
#   .claude/check --baseline   record today's findings where a baseline is missing (.claude/baseline/: dependency-cruiser,
#               ESLint CI suppressions; complexipy-snapshot.json). Existing baselines only shrink: fixed findings leave,
#               new ones never enter, so rerunning it cannot hide anything. Checks also shrink them as code gets fixed.
# Exit: 0 ok, 1 findings, 2 a configured tool could not run.
set -u
export NO_COLOR=1
cd "$(git rev-parse --show-toplevel)" || exit 2
IFS='
'
set -f
DIFF=${CHECK_DIFF:-git diff --cached -U0 -w --no-color}
PY_SRC=src # Python: the package directory vulture and complexipy scan (setup.sh sets it; flat layouts name the package)
BL=.claude/baseline
MAX_COGNITIVE=15
TMP=$(mktemp -d) && trap 'rm -rf "$TMP"' EXIT
rc=0

tool() { for d in node_modules/.bin .venv/bin .claude/tools/node_modules/.bin; do [ -x "$d/$1" ] && { echo "$d/$1"; return; }; done; command -v "$1"; }
# need CONFIG TOOL: the repo uses TOOL (CONFIG exists) and it is installed; sets X to its path
need() { [ -e "$1" ] || return 1; X=$(tool "$2"); [ -n "$X" ] && return 0; echo "skipped $2 (not installed)"; return 1; }
found() { echo "== $1"; head -n 30 "$2" | cut -c1-240; rc=1; }
broken() { echo "== $1 could not run: $(head -c 300 "$2")"; [ $rc -eq 0 ] && rc=2; return 1; }
# run NAME CMD...: output in $TMP/out. A linter that exits non-zero without printing a `path:line:` finding could not
# run (a broken config makes oxlint print its error on stdout and exit 1, which must not read as "no findings").
run() {
  name=$1; shift; "$@" > "$TMP/out" 2> "$TMP/err"; s=$?
  [ $s -eq 0 ] || grep -Eq '^[^:]+:(cell [0-9]+:)?[0-9]+:' "$TMP/out" || { cat "$TMP/err" "$TMP/out" > "$TMP/why"; broken "$name" "$TMP/why"; }
}
# cells: ruff and ty report notebook findings as `nb.ipynb:cell 2:3:1: ...`; rewrite them to the line in the .ipynb file,
# which is what the diff has. Jupyter writes each source line of a cell on its own JSON line.
cells() {
  python3 - "$TMP/out" << 'PY'
import json, re, sys
seen, res = {}, []
def sources(nb):  # per cell: the line of its "source" key, and whether its lines follow (a list) or it is one string
    if nb not in seen:
        text = open(nb).read().splitlines()
        s = [(i + 1, l.endswith('[')) for i, l in enumerate(text) if l.startswith('   "source": ')]
        seen[nb] = s if len(s) == len(json.loads('\n'.join(text))['cells']) else None  # ponytail: other layouts are dropped
    return seen[nb]
for l in open(sys.argv[1]).read().splitlines():
    m = re.match(r'(.+\.ipynb):cell (\d+):(\d+):(.*)', l)
    if not m: res.append(l); continue
    if s := sources(m[1]):
        n, multi = s[int(m[2]) - 1]
        res.append(f'{m[1]}:{n + int(m[3]) if multi else n}:{m[4]}')
open(sys.argv[1], 'w').write('\n'.join(res) + '\n')
PY
}
# added NAME: report the findings in $TMP/out (`path:line:...`) that sit on lines the diff adds
added() {
  sed "s|^$PWD/||" "$TMP/out" > "$TMP/rel"
  awk '
    FILENAME == ARGV[1] {                              # the diff: remember "path:line" of every added line
      if (/^diff --git /) { head = 1; next }
      if (head && /^\+\+\+ /) { f = substr($0, 7); sub(/\t$/, "", f); next } # "+++ b/<path>" (a tab ends paths with spaces)
      if (/^@@ /) { head = 0; split($3, h, ","); n = substr(h[1], 2) + 0; next }
      if (head) next
      if (/^\+/) add[f ":" n++] = 1; else if (/^ /) n++ # context lines (CHECK_DIFF without -U0) are not added
      next
    }
    { split($0, p, ":"); if ((p[1] ":" p[2]) in add) print }' "$TMP/diff" "$TMP/rel" > "$TMP/new"
  [ ! -s "$TMP/new" ] || found "$1" "$TMP/new"
}
# gate NAME PATTERN CMD...: a whole-project check; a non-zero exit is a finding when the output matches PATTERN
gate() {
  name=$1 pat=$2; shift 2
  "$@" > "$TMP/out" 2>&1 && return
  if grep -Eq "$pat" "$TMP/out"; then found "$name" "$TMP/out"; else broken "$name" "$TMP/out"; fi
}

if [ "${1:-}" = --baseline ]; then
  mkdir -p "$BL"
  if need .dependency-cruiser.cjs depcruise; then
    mode=full; [ ! -f "$BL/depcruise.json" ] || mode=shrink-only
    "$X" --config .dependency-cruiser.cjs --baseline "$BL/depcruise.json" --baseline-mode $mode src 2> /dev/null
    echo "dependency-cruiser: $(grep -c '"rule":' "$BL/depcruise.json") known violations"
  fi
  if [ -f pyproject.toml ] && need "$PY_SRC" complexipy; then # an existing snapshot shrinks by itself on every check
    [ -f complexipy-snapshot.json ] || "$X" "$PY_SRC" --max-complexity-allowed $MAX_COGNITIVE --snapshot-create > /dev/null
    echo "complexipy: $(cat complexipy-snapshot.json 2> /dev/null | grep -c '"complexity":') functions over $MAX_COGNITIVE"
  fi
  if need eslint.ci.config.mjs eslint; then
    how=--suppress-all; [ ! -f "$BL/eslint-suppressions.json" ] || how=--prune-suppressions
    "$X" -c eslint.ci.config.mjs $how --suppressions-location "$BL/eslint-suppressions.json" src > /dev/null
    echo "ESLint CI: $(grep -o '"count": *[0-9]*' "$BL/eslint-suppressions.json" | awk -F: '{ s += $2 } END { print s + 0 }') suppressed findings"
  fi
  echo "The gates skip these known problems. Fix the few you can now, then review the diff and commit it."; exit 0
fi

sh -c "$DIFF" > "$TMP/diff" 2> "$TMP/err" || { echo "== CHECK_DIFF failed ($DIFF): $(head -c 300 "$TMP/err")"; exit 2; } # never a silent pass
CHANGED=$(awk '/^\+\+\+ b\// { f = substr($0, 7); sub(/\t$/, "", f); print f }' "$TMP/diff" | while read -r f; do [ -f "$f" ] && echo "$f"; done)
pick() { printf '%s\n' "$CHANGED" | grep -E "$1"; }
# pyconf NAME: the repo configures NAME in pyproject.toml ([tool.NAME])
pyconf() { grep -qs "^\[tool\.$1[].]" pyproject.toml; }
JS=$(pick '\.[cm]?[jt]sx?$'); PY=$(pick '\.(py|ipynb)$'); SWIFT=$(pick '\.swift$'); KT=$(pick '\.kts?$')

if [ -n "$JS" ]; then
  if need oxlint.config.mjs oxlint; then
    run oxlint "$X" -c oxlint.config.mjs --type-aware --quiet --format unix --no-error-on-unmatched-pattern $JS && added oxlint
  fi
  if need eslint.config.js eslint; then # Expo apps: the `expo lint` rules (eslint-config-expo), errors only
    "$X" -f json --no-warn-ignored $JS > "$TMP/eslint.json" 2> "$TMP/err"
    if node -e 'for (const f of JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))) for (const m of f.messages)
      if (m.severity === 2) console.log(`${require("path").relative(process.cwd(), f.filePath)}:${m.line}:${m.column}: ${m.message.split("\n")[0]} [${m.ruleId}]`)' "$TMP/eslint.json" > "$TMP/out"
    then added 'expo lint'; else broken 'expo lint' "$TMP/err"; fi
  fi
  if need tsconfig.json tsc; then
    # Expo apps: gitignored, written by `expo start`; tsc needs it for asset/CSS-module types on fresh clones and CI
    [ ! -f app.json ] || [ -f expo-env.d.ts ] || echo '/// <reference types="expo/types" />' > expo-env.d.ts
    gate tsc ' error TS[0-9]+' "$X" --noEmit --pretty false -p tsconfig.json
    if [ -f src/__tests__/tsconfig.json ] && find src/__tests__ -name '*.ts*' ! -name tsconfig.json | grep -q .; then
      gate 'tsc (tests)' ' error TS[0-9]+' "$X" --noEmit --pretty false -p src/__tests__/tsconfig.json
    fi
  fi
  if need .dependency-cruiser.cjs depcruise; then # fixed violations leave the baseline first, so they cannot come back unseen
    [ ! -f "$BL/depcruise.json" ] || "$X" --config .dependency-cruiser.cjs --baseline "$BL/depcruise.json" --baseline-mode shrink-only src > /dev/null 2>&1
    gate dependency-cruiser 'dependency violations' "$X" --config .dependency-cruiser.cjs --ignore-known "$BL/depcruise.json" src
  fi
fi
if [ -n "$PY" ]; then
  if { [ -f ruff.toml ] || pyconf ruff; } && need pyproject.toml ruff; then run ruff "$X" check --no-fix --force-exclude --output-format concise $PY && cells && added ruff; fi
  # type errors on added lines; a changed signature that breaks an unchanged caller is for the tests. A repo that
  # already uses pyrefly keeps it instead of ty
  if [ -f pyrefly.toml ] || pyconf pyrefly; then
    if need pyproject.toml pyrefly; then
      run pyrefly "$X" check --output-format min-text $PY && { sed -n 's/^ERROR //p' "$TMP/out" > "$TMP/o2"; mv "$TMP/o2" "$TMP/out"; added pyrefly; }
    fi
  elif need pyproject.toml ty; then
    run ty "$X" check --output-format concise $PY && { grep ': error\[' "$TMP/out" > "$TMP/o2"; mv "$TMP/o2" "$TMP/out"; cells; added ty; }
  fi
  if need "$PY_SRC" vulture; then # 60%: at 80 vulture hides unused functions and classes. Use from tests does not count,
    # use from notebooks does (their code cells, magics dropped, as extra files that are never reported themselves)
    for nb in $(git ls-files '*.ipynb'); do
      python3 -c 'import json, sys; print("\n".join(l for c in json.load(open(sys.argv[1]))["cells"] if c["cell_type"] == "code"
        for l in "".join(c["source"]).splitlines() if not l.lstrip().startswith(("%", "!"))))' "$nb" > "$TMP/nb_$(echo "$nb" | tr / _).py"
    done
    run vulture "$X" "$PY_SRC" $(find "$TMP" -name 'nb_*.py') --min-confidence 60 && added vulture
  fi
  if need "$PY_SRC" complexipy; then # complexipy-snapshot.json (from --baseline), when present, holds the legacy offenders
    gate complexipy '\.py ' "$X" "$PY_SRC" --max-complexity-allowed $MAX_COGNITIVE --plain --failed
  fi
  if { [ -f .importlinter ] || pyconf importlinter; } && need pyproject.toml lint-imports; then gate import-linter ' BROKEN' "$X" --no-logo; fi
fi
if [ -n "$SWIFT" ] && need .swiftlint.yml swiftlint; then
  run swiftlint "$X" lint --quiet --config .swiftlint.yml $SWIFT && { grep ': error: ' "$TMP/out" > "$TMP/o2"; mv "$TMP/o2" "$TMP/out"; added swiftlint; }
fi
if [ -n "$KT" ] && need android/config/detekt.yml detekt; then
  run detekt "$X" --config android/config/detekt.yml --input "$(printf '%s\n' "$KT" | paste -sd, -)" && added detekt
fi
# Copy-paste on added lines: each clone is reported at both copies and the old copy is filtered out. A clone counts at
# its first line, so extending old copied code at its end goes unseen. (jscpd's --baseline-from-ref would see it, but
# checks out the whole base into a temporary worktree: gigabytes in a repo that tracks data.)
if [ -n "$CHANGED" ] && need .jscpd.json jscpd; then
  if "$X" --reporters json -o "$TMP/cpd" --silent --no-colors > "$TMP/err" 2>&1 && [ -f "$TMP/cpd/jscpd-report.json" ]; then
    node -e 'for (const d of JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).duplicates)
      for (const [a, b] of [[d.firstFile, d.secondFile], [d.secondFile, d.firstFile]]) console.log(`${a.name}:${a.start}: duplicates ${b.name}:${b.start} (${d.tokens} tokens)`)' \
      "$TMP/cpd/jscpd-report.json" > "$TMP/out" && added 'jscpd: new copy-paste; reuse the existing code'
  else broken jscpd "$TMP/err"; fi
fi
exit $rc
