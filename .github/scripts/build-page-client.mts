// Compiles src/bridge/pageClient.ts, with the endpoint.ts it imports, into src/bridge/pageClient.generated.ts: the page
// client as one function expression in a string, so native can inject `(<PAGE_CLIENT>)(window, <timeoutMs>, <origins>)`
// at document start. Both files import only types otherwise, so the build only drops imports and exports.
// Run after editing either: node .github/scripts/build-page-client.mts (`--check` fails if the output is stale).
import { readFileSync, writeFileSync } from 'node:fs';
import ts from 'typescript';

const compile = (file: string) => {
  const { outputText } = ts.transpileModule(
    readFileSync(new URL(`../../src/bridge/${file}`, import.meta.url), 'utf8'),
    {
      compilerOptions: {
        target: ts.ScriptTarget.ES2020,
        module: ts.ModuleKind.ESNext,
        removeComments: true,
      },
    }
  );
  return outputText
    .replace(/^import .*;\n/gm, '')
    .replace(/^export /gm, '')
    .trim();
};
const body = [compile('endpoint.ts'), compile('pageClient.ts')].join('\n');
if (/^\s*(import|export)\b/m.test(body))
  throw new Error('the page client may only import createEndpoint and types');
const fn = `function (w, timeoutMs, allowedOrigins) {\n${body}\nreturn installPageClient(w, timeoutMs, allowedOrigins);\n}`;
const target = new URL('../../src/bridge/pageClient.generated.ts', import.meta.url);
const output = `// Generated by .github/scripts/build-page-client.mts from pageClient.ts and endpoint.ts. Do not edit.\nexport const PAGE_CLIENT =\n  ${JSON.stringify(fn)};\n`;

if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8') !== output)
    throw new Error(
      'pageClient.generated.ts is stale: run node .github/scripts/build-page-client.mts'
    );
} else {
  writeFileSync(target, output);
}
