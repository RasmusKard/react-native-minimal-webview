// Compiles src/bridge/pageClient.ts, with the endpoint.ts it imports, into src/bridge/pageClient.generated.ts: the page
// client as one function expression in a string, so native can inject `(<PAGE_CLIENT>)(window, <timeoutMs>, <origins>)`
// at document start, and endpoint.ts's matchesOrigin on its own. Both files import only types otherwise, so the build
// only drops imports and exports.
// Run after editing either: node .github/scripts/build-page-client.mts (`--check` fails if the output is stale).
import { readFileSync, writeFileSync } from 'node:fs';
import ts from 'typescript';

const compile = (file: string) => {
  const { outputText } = ts.transpileModule(
    readFileSync(new URL(`../../src/bridge/${file}`, import.meta.url), 'utf8'),
    {
      compilerOptions: {
        target: ts.ScriptTarget.ES2020,
        module: ts.ModuleKind.ESNext,
        removeComments: true,
      },
    }
  );
  return outputText
    .replace(/^import .*;\n/gm, '')
    .replace(/^export /gm, '')
    .trim();
};
const endpoint = compile('endpoint.ts');
const body = [endpoint, compile('pageClient.ts')].join('\n');
if (/^\s*(import|export)\b/m.test(body))
  throw new Error('the page client may only import from endpoint.ts, and types');
const fn = `function (w, timeoutMs, allowedOrigins) {\n${body}\nreturn installPageClient(w, timeoutMs, allowedOrigins);\n}`;
const target = new URL('../../src/bridge/pageClient.generated.ts', import.meta.url);
// endpoint.ts's matchesOrigin and the helper it calls, for the injected scripts' origin guard (WebView.tsx).
const source = ts.createSourceFile('endpoint.js', endpoint, ts.ScriptTarget.ES2020);
const functionText = (name: string) => {
  const found = source.statements.find((s) => ts.isFunctionDeclaration(s) && s.name?.text === name);
  if (!found) throw new Error(`endpoint.ts has no function ${name}`);
  return found.getText(source);
};
const matcher = `(() => {\n${functionText('hasAt')}\n${functionText('matchesOrigin')}\nreturn matchesOrigin;\n})()`;
const output = `// Generated by .github/scripts/build-page-client.mts from pageClient.ts and endpoint.ts. Do not edit.\nexport const PAGE_CLIENT =\n  ${JSON.stringify(fn)};\nexport const MATCHES_ORIGIN =\n  ${JSON.stringify(matcher)};\n`;

if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8') !== output)
    throw new Error(
      'pageClient.generated.ts is stale: run node .github/scripts/build-page-client.mts'
    );
} else {
  writeFileSync(target, output);
}
