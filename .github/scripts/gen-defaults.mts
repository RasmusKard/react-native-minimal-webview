// Generates src/defaults.generated.ts: DEFAULTS, the package's runtime defaults by type and member, from the
// `@default` tags of the members of src/types.ts's interfaces and object types, so that each default is written once.
// A `@default` must be one `code` span holding a TypeScript expression; anything else fails the run.
// Run after editing one: npm run gen:defaults (`--check` fails if the output is stale).
import { readFileSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import prettier from 'prettier';
import ts from 'typescript';

const source = new URL('../../src/types.ts', import.meta.url);
const target = new URL('../../src/defaults.generated.ts', import.meta.url);

const file = ts.createSourceFile(
  'types.ts',
  readFileSync(source, 'utf8'),
  ts.ScriptTarget.Latest,
  true
);
const defaults: Record<string, Record<string, string>> = {};
// shortcut: reads only the direct members of a top-level interface or object type; extend it before a `@default` goes
// on a member of a union, an intersection or a nested object type.
for (const node of file.statements) {
  if (!ts.isInterfaceDeclaration(node) && !ts.isTypeAliasDeclaration(node)) continue;
  const members = ts.isInterfaceDeclaration(node)
    ? node.members
    : ts.isTypeLiteralNode(node.type)
      ? node.type.members
      : [];
  for (const member of members) {
    const tag = ts.getJSDocTags(member).find((t) => t.tagName.text === 'default');
    if (!tag) continue;
    const key = member.name!.getText();
    const code = ts.getTextOfJSDocComment(tag.comment)?.match(/^`([^`]+)`$/)?.[1];
    if (!code) throw new Error(`${node.name.text}.${key}: @default must be one \`code\` span`);
    (defaults[node.name.text] ??= {})[key] = code;
  }
}

const object = (entries: Record<string, string>) =>
  `{ ${Object.entries(entries)
    .map(([key, value]) => `${key}: ${value}`)
    .join(', ')} }`;
const output = await prettier.format(
  `// Generated by .github/scripts/gen-defaults.mts from the @default tags in src/types.ts. Do not edit.
export const DEFAULTS = ${object(
    Object.fromEntries(Object.entries(defaults).map(([type, members]) => [type, object(members)]))
  )};
`,
  { ...(await prettier.resolveConfig(fileURLToPath(target))), parser: 'typescript' }
);
if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8') !== output)
    throw new Error('defaults.generated.ts is stale: run npm run gen:defaults');
} else {
  writeFileSync(target, output);
}
