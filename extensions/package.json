{
  "name": "@react-native-minimal-webview/extensions",
  "version": "1.1.0",
  "description": "Native hooks for react-native-minimal-webview that bring back react-native-webview props, such as onScroll and basicAuthCredential, and add JS-answered dialogs",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "react-native": "src/index.ts",
  "files": [
    "build",
    "!build/gradle",
    "src",
    "!src/**/__tests__",
    "*/*.swift",
    "*/*.kt",
    "*/*.ts",
    "MinimalWebViewExtensions.podspec",
    "build.gradle",
    "consumer-rules.pro",
    "expo-module.config.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "tsc"
  },
  "keywords": [
    "react-native",
    "expo",
    "react-native-minimal-webview",
    "react-native-webview"
  ],
  "repository": "https://github.com/RasmusKard/react-native-minimal-webview",
  "bugs": {
    "url": "https://github.com/RasmusKard/react-native-minimal-webview/issues"
  },
  "author": "Rasmus Kard <rasmuskard@gmail.com> (https://github.com/RasmusKard)",
  "license": "MIT",
  "homepage": "https://github.com/RasmusKard/react-native-minimal-webview/tree/main/extensions#readme",
  "devDependencies": {
    "react-native-minimal-webview": "workspace:*"
  },
  "peerDependencies": {
    "expo": ">=53",
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-minimal-webview": "^1.0.0"
  }
}
