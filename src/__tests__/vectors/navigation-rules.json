{
  "description": "Shared navigation rule cases for the Kotlin and Swift matchers. Request fields default to mainFrame true, newWindow false, userInitiated false, asked [] (URLs an `ask` already allowed) and canAsk true (something can answer an `ask`). `rules` names a ruleset or is null (no navigationRules). `expect.rule` is the index of the matching rule, or null when a default decided. Semantics: (0) a new window to about:, blob:, data:, javascript: or file: blocks, before anything else, so no rule can allow it; (1) otherwise about:, data: and javascript: URLs always allow and skip the rules; (2) with no rules (null or []) nothing matches, so the rest blocks: for an unset prop JS sends the `defaults` ruleset, which equals defaultNavigationRules; (3) with rules, the first rule whose set fields all match wins, and no match blocks; a blob: URL is matched as the origin it carries: its inner URL's scheme and host, path '/' and no query (`blob:https://a.test/x` as `https://a.test/`), and one with an opaque origin (`blob:null/x`, an inner URL without a scheme) blocks; a rule action other than allow, block, external or ask blocks; (4) an `ask` blocks when canAsk is false, else allows when the URL is in asked. Matching: scheme, host, path and query are lists, and a rule whose field is not a list never matches; scheme exact and case-insensitive; host case-insensitive without port, userinfo or a trailing dot, exact or `*.` suffix (subdomains only); path is a plain prefix of the percent-encoded path, an empty path, or any path of a URL without an authority (`myapp:/abs`), counts as '/'; query entries are compared, case-sensitive, with the parameters of the percent-encoded query (its non-empty `&`-separated parts, the fragment excluded): `name=value` equals a parameter, `name` equals a parameter's text before its first `=`. `answers`: an `ask` answer of allow, block or external stands; anything else blocks.",
  "rulesets": {
    "defaults": [
      {
        "scheme": ["file"],
        "action": "block"
      },
      {
        "scheme": ["http", "https"],
        "action": "allow"
      },
      {
        "mainFrame": true,
        "userInitiated": true,
        "action": "external"
      }
    ],
    "app": [
      {
        "scheme": ["tel", "mailto", "sms"],
        "action": "external"
      },
      {
        "host": ["*.example.com"],
        "path": ["/checkout"],
        "action": "ask"
      },
      {
        "host": ["example.com", "*.example.com"],
        "action": "allow"
      },
      {
        "newWindow": true,
        "action": "external"
      },
      {
        "scheme": ["http", "https"],
        "mainFrame": false,
        "action": "allow"
      },
      {
        "scheme": ["http", "https"],
        "action": "external"
      }
    ],
    "fields": [
      {
        "userInitiated": true,
        "action": "external"
      },
      {
        "host": ["EXAMPLE.com"],
        "path": ["/a%20b", "/x"],
        "action": "ask"
      },
      {
        "host": ["xn--mnchen-3ya.de"],
        "action": "allow"
      },
      {
        "scheme": ["HTTPS"],
        "host": ["*.example.com"],
        "action": "allow"
      }
    ],
    "catchAll": [
      {
        "action": "block"
      },
      {
        "action": "allow"
      }
    ],
    "notAList": [
      {
        "scheme": "tel",
        "action": "external"
      },
      {
        "action": "allow"
      }
    ],
    "query": [
      {
        "query": ["gad_source", "utm_term=google"],
        "action": "external"
      },
      {
        "query": ["a%20b=c%2Fd"],
        "action": "block"
      },
      {
        "action": "allow"
      }
    ],
    "empty": [],
    "unknownAction": [
      {
        "action": "deny"
      }
    ],
    "paths": [
      {
        "path": ["/abs", "/etc"],
        "action": "block"
      },
      {
        "action": "allow"
      }
    ],
    "customScheme": [
      {
        "scheme": ["myapp"],
        "action": "external"
      }
    ]
  },
  "cases": [
    {
      "name": "defaults: https allows",
      "rules": "defaults",
      "request": {
        "url": "https://example.com/"
      },
      "expect": {
        "action": "allow",
        "rule": 1
      }
    },
