{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../src/index.ts"],
  "out": "../docs",
  "plugin": ["../.github/scripts/typedoc-plugin.mts"],
  "customCss": "typedoc.css",
  "readme": "../README.md",
  "headings": { "readme": false },
  "disableSources": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "validation": { "notExported": false },
  "navigation": { "includeGroups": true },
  "visibilityFilters": { "@android": true, "@ios": true },
  "locales": { "en": { "tag_ios": "iOS" } },
  "useFirstParagraphOfCommentAsSummary": true,
  "searchInComments": true,
  "includeHierarchySummary": false,
  "navigationLinks": { "GitHub": "https://github.com/RasmusKard/minimal-rn-webview" },
  "highlightLanguages": ["bash", "console", "css", "html", "javascript", "json", "jsonc", "json5", "yaml", "tsx", "typescript", "kotlin", "swift"],
  "groupOrder": ["Documents", "WebView", "Navigation", "Events", "Bridge", "Scripts", "Page requests", "Native hooks", "Platform settings"]
}
