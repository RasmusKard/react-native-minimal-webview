{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../src/index.ts", "../extensions/src/index.ts"],
  "tsconfig": "tsconfig.typedoc.json",
  "plugin": ["typedoc-plugin-markdown", "../.github/scripts/typedoc-plugin.mts", "tsdoc-defaults/typedoc"],
  "readme": "none",
  "excludeScopesInPaths": true,
  "useCodeBlocks": true,
  "indexFormat": "table",
  "parametersFormat": "table",
  "propertyMembersFormat": "table",
  "enumMembersFormat": "table",
  "disableSources": true,
  "excludeExternals": true,
  "treatWarningsAsErrors": true,
  "sortEntryPoints": false,
  "pageTitleTemplates": { "index": "TypeScript API" },
  "validation": { "notExported": false },
  "groupOrder": ["Extensions", "Values", "WebView", "Navigation", "Events", "Bridge", "Scripts", "Page requests", "Native hooks", "Platform settings"]
}
