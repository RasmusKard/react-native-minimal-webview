{
  "name": "react-native-minimal-webview",
  "version": "0.1.0",
  "description": "A minimal, extensible WebView for React Native (Expo Modules)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "ios",
    "!ios/Tests",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc && tsc -p extensions",
    "clean": "rm -rf build extensions/build",
    "pretest": "npm run build:page-client -- --check && npm run gen:platform-types -- --check && npm run gen:defaults -- --check",
    "test": "jest",
    "lint": "eslint --max-warnings 0 src extensions example .github",
    "prepare": "npm run clean && npm run build",
    "check": "npm test && npm run lint && knip --config .config/knip.json && tsc --noEmit -p src/__tests__/tsconfig.json && tsc --noEmit -p extensions/src/__tests__/tsconfig.json && (cd example && npx tsc --noEmit) && npm run prepare && npm run docs:check",
    "mutation": "stryker run .config/stryker.config.json",
    "build:page-client": "node .github/scripts/build-page-client.mts",
    "gen:platform-types": "node .github/scripts/gen-platform-types.mts",
    "gen:defaults": "tsdoc-defaults",
    "docs": "rn-cross-platform-docs generate --out build/docs/reference && rn-cross-platform-docs-zensical build --reference build/docs/reference --out build/docs/site --site-url https://rasmuskard.github.io/react-native-minimal-webview/ && rm -rf docs && cp -R build/docs/site/site docs && touch docs/.nojekyll",
    "docs:check": "typedoc --emit none"
  },
  "keywords": [
    "react-native",
    "expo",
    "react-native-minimal-webview",
    "MinimalWebView"
  ],
  "repository": "https://github.com/RasmusKard/react-native-minimal-webview",
  "bugs": {
    "url": "https://github.com/RasmusKard/react-native-minimal-webview/issues"
  },
  "author": "Rasmus Kard <rasmus.kard@delfi.ee> (https://github.com/RasmusKard)",
  "license": "MIT",
  "homepage": "https://github.com/RasmusKard/react-native-minimal-webview#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@rn-cross-platform-docs/cli": "1.3.0",
    "@rn-cross-platform-docs/zensical": "1.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "expo": "~58.0.19",
    "globals": "^17.13.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.12",
    "knip": "6.43.0",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "test-renderer": "1.3.1",
    "tsdoc-defaults": "^1.0.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/extensions/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=53",
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "react-native": "src/index.ts",
  "workspaces": [
    "extensions"
  ]
}
