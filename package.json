{
  "name": "minimal-rn-webview",
  "version": "0.1.0",
  "description": "A minimal, extensible WebView for React Native (Expo Modules)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "src",
    "!src/**/__tests__",
    "ios",
    "!ios/Tests",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "pretest": "npm run build:page-client -- --check && npm run gen:platform-types -- --check",
    "test": "jest",
    "lint": "eslint --max-warnings 0 src example .github",
    "prepare": "npm run clean && npm run build",
    "check": "npm test && npm run lint && knip && tsc --noEmit -p src/__tests__/tsconfig.json && (cd example && npx tsc --noEmit) && npm run prepare",
    "mutation": "stryker run",
    "build:page-client": "node .github/scripts/build-page-client.mts",
    "gen:platform-types": "node .github/scripts/gen-platform-types.mts"
  },
  "keywords": [
    "react-native",
    "expo",
    "minimal-rn-webview",
    "MinimalWebView"
  ],
  "repository": "https://github.com/RasmusKard/minimal-rn-webview",
  "bugs": {
    "url": "https://github.com/RasmusKard/minimal-rn-webview/issues"
  },
  "author": "Rasmus Kard <rasmus.kard@delfi.ee> (https://github.com/RasmusKard)",
  "license": "MIT",
  "homepage": "https://github.com/RasmusKard/minimal-rn-webview#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "expo": "~58.0.17",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.12",
    "knip": "6.40.0",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=53",
    "react": ">=19",
    "react-native": ">=0.79"
  },
  "react-native": "src/index.ts"
}
